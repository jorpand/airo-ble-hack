# ---------------------------------------------------------------------------
# Node / frontend (web/)
# ---------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnpm-store/

# La build de Vite no se versiona: se regenera con `npm run build`.
# La API FastAPI la sirve desde web/dist, asi que hay que compilarla
# antes de arrancar el backend (ver README).
web/dist/
web/.vite/
web/.vitest-cache/
web/coverage/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Secretos y configuracion local
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# ---------------------------------------------------------------------------
# Datos locales del robot (calibracion y programas guardados)
# ---------------------------------------------------------------------------
*.airo
guardado.json
calibration.local.json

# ---------------------------------------------------------------------------
# Artefactos propios del proyecto
# ---------------------------------------------------------------------------
# Volcados generados del desensamblado del APK: pesan ~19 MB y se
# regeneran con los scripts de tools/rev/. Solo se versiona el codigo.
tools/rev/*.txt
tools/rev/*.tsv
tools/rev/*.bin
tools/rev/*.dex

# La carpeta de trabajo local: aqui se capturan las pruebas y se dejan los
# volcados. Lo que se publica vive en docs/.
evidencia/

# Bases de datos y ficheros generados en general
*.db
*.sqlite
*.sqlite3
*.log

# ---------------------------------------------------------------------------
# mise (las overrides locales de cada maquina)
.mise.local.toml

