"""Stubs del modulo `network` de MicroPython (ESP32).

Solo para que pyright pueda comprobar `firmware/esp32/wifi.py`. No es codigo
del chip: no se copia a la placa.
"""

from typing import Any

STA_IF: int
AP_IF: int

#: Fija (o lee) el nombre del host. En el ESP32 esto es lo que publica el
#: responder de mDNS, asi que hay que ponerlo **antes** de activar la WiFi.
def hostname(name: str = ..., /) -> str: ...

class WLAN:
    def __init__(self, iface: int, /) -> None: ...
    def active(self, active: bool | None = ..., /) -> Any: ...
    def connect(self, ssid: str, password: str | None = ..., /) -> None: ...
    def isconnected(self) -> bool: ...
    def ifconfig(self, config: Any = ..., /) -> Any: ...
    def config(self, interface: str = ..., /, **kwargs: Any) -> Any: ...
    def disconnect(self, /) -> None: ...
